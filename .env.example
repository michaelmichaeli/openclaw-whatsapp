# OpenClaw Environment Configuration
# Copy this to .env and fill in your actual API keys

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# OpenCode API Key (for opencode model)
OPENCODE_API_KEY=sk-YOUR_KEY_HERE

# OpenClaw Gateway Token (for remote access)
OPENCLAW_GATEWAY_TOKEN=sk-openclaw-YOUR_TOKEN_HERE

# State and config paths
OPENCLAW_STATE_DIR=/opt/openclaw/.state
OPENCLAW_CONFIG_PATH=/opt/openclaw/openclaw.json

# Load shell environment
OPENCLAW_LOAD_SHELL_ENV=1

# ── Google Calendar ─────────────────────────────────────────────────────────
# Create OAuth 2.0 credentials in Google Cloud Console (type: Desktop app)
# then run: python3 calendar_creator/setup_google_auth.py
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# ── Apple Calendar (iCloud) ──────────────────────────────────────────────────
# Generate an App-Specific Password at https://appleid.apple.com
# Sign-In & Security → App-Specific Passwords → Generate
APPLE_ID=your_apple_id@icloud.com
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
